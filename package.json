{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ds": "bun design-system/build.ts",
    "ds:check": "bun design-system/build.ts --check",
    "ds:show": "bun design-system/show.ts",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "typecheck:slow": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings design-system packages",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "e2e": "bun dev/tui-e2e.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run ds:check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.0"
  }
}
