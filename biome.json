{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": false
  },
  "files": {
    "includes": ["design-system/**/*.ts", "packages/**/*.ts", "dev/tmux.ts", "dev/replay/**/*.ts", "*.ts", "*.json", "!!**/.claude"],
    "ignoreUnknown": true
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  }
}
