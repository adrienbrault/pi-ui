{
  "name": "@adrienbrault/pi-ui",
  "version": "0.1.0",
  "description": "A terminal UI for the pi coding agent: compact tool rows and thinking blocks that condense as the session moves on, with highlighted output, file diffs and click to expand.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "tui",
    "terminal",
    "coding-agent",
    "extension"
  ],
  "license": "MIT",
  "author": "Adrien Brault",
  "homepage": "https://github.com/adrienbrault/pi-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrienbrault/pi-ui.git",
    "directory": "packages/pi-ui"
  },
  "bugs": {
    "url": "https://github.com/adrienbrault/pi-ui/issues"
  },
  "type": "module",
  "files": [
    "extensions/**/*.ts",
    "render/**/*.ts",
    "!**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "dependencies": {
    "diff": "8.0.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2"
  }
}
